  const [selectedCycle, setSelectedCycle] = useState(null);

  if (!cycles || cycles.length === 0) {
    return (
      <div className="bg-zinc-900/60 border border-zinc-800 rounded-3xl p-8 text-center text-gray-400 text-sm">
