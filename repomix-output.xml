<file path=".github/workflows/ci.yml">
name: CI - Build Docker Images

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  build-backend:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Build backend image
        run: docker build -t obligation-backend ./backend

  build-frontend:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Build frontend image
        run: docker build -t obligation-frontend ./frontend

  deploy:
    needs: [build-backend, build-frontend]
    if: github.ref == 'refs/heads/main' && github.event_name == 'push'
    runs-on: ubuntu-latest
    steps:
      - name: Deploy to Oracle VM via Blue-Green Script
        uses: appleboy/ssh-action@v1.0.3
        with:
          host: ${{ secrets.VM_HOST }}
          username: ${{ secrets.VM_USER }}
          key: ${{ secrets.VM_SSH_KEY }}
          command_timeout: 20m
          script: |
            cd ${{ secrets.VM_PROJECT_PATH }}
            chmod +x deploy-bg.sh || true
            # Run the automated deployment script
            bash deploy-bg.sh

      - name: Verify Live Endpoint
        run: |
          sleep 15
          # Verify that the public production site is up and responsive
          curl --retry 5 --retry-delay 3 --retry-all-errors -f https://settld.duckdns.org || exit 1
</file>

