<file path="frontend/src/services/pushTokenService.js">
import { supabase } from '../lib/supabase.ts';

export const pushTokenService = {
  async saveToken(userId, token, channel = 'fcm') {
    const deviceType = navigator.userAgent.includes('Mobile') ? 'mobile_web' : 'desktop_web';
    
    const { data, error } = await supabase
      .from('user_push_tokens')
      .upsert({
        user_id: userId,
        fcm_token: token,
        device_type: deviceType,
        updated_at: new Date().toISOString()
      }, { onConflict: 'fcm_token' });

    if (error) throw error;
    return data;
  },

  async deleteToken(token) {
    const { error } = await supabase
      .from('user_push_tokens')
      .delete()
      .eq('fcm_token', token);

    if (error) throw error;
  }
};
</file>

<file path="frontend/src/utils/dateUtils.js">
export function getDaySuffix(day) {
  const d = Number(day);
  if (d > 3 && d < 21) return 'th';
  switch (d % 10) {
    case 1: return 'st';
    case 2: return 'nd';
    case 3: return 'rd';
    default: return 'th';
  }
}
</file>

